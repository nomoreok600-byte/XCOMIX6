# ----- HTTP -----
PORT=4000
# Comma separated list of allowed browser origins (CORS). The live frontend is
# the static site at xcomix.top. Add localhost origins for local testing only.
FRONTEND_ORIGIN=https://www.xcomix.top,https://xcomix.top

# ----- MySQL -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=xcomix
DB_PASSWORD=change-me
DB_NAME=xcomix
DB_CONNECTION_LIMIT=10

# ----- Image proxy stealth -----
# Optional Cloudflare clearance cookie string (e.g. "cf_clearance=abc123").
# Forwarded verbatim to source hosts that gate images behind Cloudflare.
PROXY_CF_COOKIE=
# Seconds the browser may cache proxied images.
PROXY_CACHE_MAX_AGE=86400

# ----- Accounts / admin -----
# Secret used to sign user login tokens (JWT). Use a long random string.
JWT_SECRET=change-this-to-a-long-random-string
# Token that unlocks the admin dashboard at /admin. Keep it private.
ADMIN_TOKEN=change-this-admin-token

# ----- Auto importer (no human) -----
# Set to true to auto-import the MangaKatana + ManhwaBuddy "latest" feeds on a
# timer (you can also trigger a crawl on demand from the /admin dashboard).
AUTO_IMPORT_ENABLED=false
# Minutes between automatic runs.
AUTO_IMPORT_INTERVAL_MIN=180
# Which sources to crawl automatically (comma separated): katana, buddy.
AUTO_IMPORT_SOURCES=katana,buddy
# Manga per source per run, and recent chapters to resolve page images for.
AUTO_IMPORT_LIMIT=12
AUTO_IMPORT_MAX_CHAPTERS=3
